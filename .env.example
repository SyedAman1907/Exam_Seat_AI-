# Backend Configuration (create as server/.env)
PORT=5000
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/examseat_ai?retryWrites=true&w=majority
JWT_SECRET=<REPLACE_WITH_SECURE_RANDOM_JWT_SECRET>
CLIENT_URL=https://examseatai.vercel.app
CORS_ORIGINS=https://examseatai.vercel.app,https://exam-seat-ai-eta.vercel.app,http://localhost:5173,http://localhost:5174
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=10
ENABLE_SCHEDULER=true
ADMIN_NAME=Exam Controller Admin
ADMIN_EMAIL=admin@rgmcet.edu.in
ADMIN_PASSWORD=<REPLACE_WITH_ADMIN_PASSWORD>
ADMIN_DEPARTMENT=Computer Science and Engineering
INCHARGE_EMAIL=incharge@rgmcet.edu.in
INCHARGE_PASSWORD=<REPLACE_WITH_INCHARGE_PASSWORD>

# Frontend Configuration (create as client/.env or set in Vercel Environment Variables)
# Local dev uses Vite proxy (/api -> http://localhost:5000); production uses Render backend:
VITE_API_URL=https://exam-seat-ai-1.onrender.com
